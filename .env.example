# Variables d'environnement Vercel (Settings > Environment Variables)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Expéditeur : une adresse d'un domaine vérifié sur Resend. Sans domaine vérifié,
# onboarding@resend.dev n'envoie qu'à l'adresse du compte Resend.
RESEND_FROM=Redianice <contact@ton-domaine.com>
CONTACT_TO=redianicegroup@gmail.com
# Adresse publique du site (sert au logo dans l'e-mail). Par défaut : https://redianice.vercel.app
SITE_URL=https://redianice.vercel.app
